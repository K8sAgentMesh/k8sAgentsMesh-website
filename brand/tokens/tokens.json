{
  "$meta": {
    "name": "K8sAgentMesh brand tokens — Viking North-Cross Constellation Compass",
    "source": "ISI-6046 brand identity kit, board approval card ba1755b0 (2026-10-17)",
    "lockedBase": "north-cross-v2-bots.svg (kit copy: agentMesh repo branding/logo/)",
    "canonicalLocation": "brand/tokens/tokens.css",
    "changeProcess": "PR to this directory"
  },
  "color": {
    "bg-depth-1":      { "value": "#101B30", "core": true,  "role": "mid-navy, radial gradient focus" },
    "bg-depth-2":      { "value": "#0B1220", "core": true,  "role": "deep navy, page canvas" },
    "bg-depth-3":      { "value": "#070D17", "core": true,  "role": "deepest navy, edges/footer" },
    "primary-bright":  { "value": "#7DE9FA", "core": true,  "role": "glacier cyan, top of primary ray gradient" },
    "primary-teal":    { "value": "#2DD4BF", "core": true,  "role": "compass teal, bottom of primary ray gradient" },
    "accent-sky":      { "value": "#38BDF8", "core": true,  "role": "sky blue, diagonal gradient top" },
    "accent-cyan":     { "value": "#22D3EE", "core": true,  "role": "signal cyan, diagonal gradient bottom, antenna, mesh links" },
    "star-satellite":  { "value": "#A5F3FC", "core": false, "role": "secondary agent stars, bot eyes" },
    "star-core":       { "value": "#E0FBFF", "core": false, "role": "hub halo, antenna tips, north pointer" },
    "star-white":      { "value": "#FFFFFF", "core": false, "role": "hub center" },
    "sail-mint":       { "value": "#5EEAD4", "core": false, "role": "taut sail arcs at 0.35-0.5 opacity" },
    "bot-hull":        { "value": "#0E1B2E", "core": false, "role": "agent bot chip head fill" }
  },
  "gradient": {
    "bg":       { "type": "radial", "cx": "50%", "cy": "42%", "r": "75%", "stops": ["bg-depth-1@0%", "bg-depth-2@60%", "bg-depth-3@100%"] },
    "primary":  { "type": "linear", "stops": ["primary-bright@0%", "primary-teal@100%"] },
    "diagonal": { "type": "linear", "stops": ["accent-sky@0%", "accent-cyan@100%"] }
  },
  "aliases": {
    "mesh-brand-navy":           { "ref": "bg-depth-2", "role": "hero surfaces, logo tile" },
    "mesh-brand-primary":        { "ref": "primary-teal", "role": "rays, routes, graphics, large text" },
    "mesh-brand-primary-strong": { "ref": "primary-bright", "role": "links/interactive text on dark" },
    "mesh-brand-primary-soft":   { "ref": "star-satellite", "role": "hover fills, charts" },
    "mesh-brand-accent":         { "ref": "accent-cyan", "role": "edges, highlights, mesh links" },
    "mesh-brand-accent-soft":    { "ref": "accent-sky", "role": "hover fills, charts" },
    "mesh-brand-accent-strong":  { "ref": "primary-teal", "role": "teal as text on dark" }
  }
}
