---
// Animated concept diagram for the landing page (ISI-6509).
//
// Standalone inline SVG per visual-design-spec §7 (Mermaid cannot express
// animation). Shows the concept in one picture: a client POSTs a task to the
// per-pod Gateway, the Router picks a standing AgentRuntime via the Registry,
// and the A2A NDJSON event stream flows back. The mesh-owned CRDs configure the
// mesh; the host plugs in behind the seams.
//
// Motion is CSS-only (no SMIL) so `prefers-reduced-motion: reduce` can switch
// it off. Colors are theme-aware: dark defaults with light overrides keyed off
// html[data-theme='light'], matching the landing page's pattern. Brand
// geometry per the kit: k8s-blue double-ring gateway, teal agent circle,
// JetBrains Mono labels.
---

<div class="concept-figure">
  <svg
    class="cd-svg"
    viewBox="0 0 1200 700"
    role="img"
    aria-labelledby="cd-title cd-desc"
  >
    <title id="cd-title">K8sAgentMesh concept — task flow through the mesh</title>
    <desc id="cd-desc">
      A client sends a task to the per-pod Gateway. The mesh module — Gateway,
      Router and Registry — routes it to a standing AgentRuntime. The agent's
      NDJSON event stream flows back to the client. MeshPool, MeshRoute and
      MeshTelemetry CRDs configure the mesh; the host platform plugs in behind
      the seams. Packets animate along the routes.
    </desc>
    <defs>
      <marker
        id="cd-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#5a6883"></path>
      </marker>
    </defs>

    <!-- CRD configuration chips -->
    <text class="cd-boxlabel cd-crdlabel" x="600" y="34" text-anchor="middle"
      >MESH CRDs — configuration contracts</text
    >
    <g class="cd-chip">
      <rect x="330" y="52" width="140" height="44" rx="8"></rect>
      <text x="400" y="80" text-anchor="middle">MeshPool</text>
    </g>
    <g class="cd-chip">
      <rect x="500" y="52" width="140" height="44" rx="8"></rect>
      <text x="570" y="80" text-anchor="middle">MeshRoute</text>
    </g>
    <g class="cd-chip">
      <rect x="670" y="52" width="170" height="44" rx="8"></rect>
      <text x="755" y="80" text-anchor="middle">MeshTelemetry</text>
    </g>
    <line class="cd-stem" x1="400" y1="96" x2="400" y2="140"></line>
    <line class="cd-stem" x1="570" y1="96" x2="570" y2="140"></line>
    <line class="cd-stem" x1="755" y1="96" x2="755" y2="140"></line>

    <!-- Mesh module boundary -->
    <rect class="cd-meshbox" x="300" y="140" width="560" height="400" rx="16"
    ></rect>
    <text class="cd-boxlabel" x="322" y="172">MESH MODULE — owns mechanism</text>

    <!-- Client -->
    <g class="cd-node">
      <rect x="40" y="210" width="170" height="100" rx="12"></rect>
      <text class="cd-label" x="125" y="254" text-anchor="middle">Client</text>
      <text class="cd-sub" x="125" y="280" text-anchor="middle"
        >app · CI · kubectl</text
      >
    </g>

    <!-- Gateway (double ring, k8s blue) -->
    <g class="cd-node">
      <rect
        class="cd-gw-outer"
        x="340"
        y="210"
        width="180"
        height="110"
        rx="16"></rect>
      <rect
        class="cd-gw-inner"
        x="352"
        y="222"
        width="156"
        height="86"
        rx="10"></rect>
      <text class="cd-label" x="430" y="260" text-anchor="middle">Gateway</text>
      <text class="cd-sub" x="430" y="284" text-anchor="middle"
        >per-pod manager</text
      >
    </g>

    <!-- Router -->
    <g class="cd-node">
      <rect x="600" y="210" width="160" height="110" rx="12"></rect>
      <text class="cd-label" x="680" y="260" text-anchor="middle">Router</text>
      <text class="cd-sub" x="680" y="284" text-anchor="middle"
        >route to endpoint</text
      >
    </g>

    <!-- Registry -->
    <g class="cd-node">
      <rect x="600" y="410" width="160" height="80" rx="12"></rect>
      <text class="cd-label" x="680" y="446" text-anchor="middle">Registry</text>
      <text class="cd-sub" x="680" y="470" text-anchor="middle"
        >endpoints · TTL</text
      >
    </g>

    <!-- Standing agent (teal circle) -->
    <circle class="cd-halo" cx="1050" cy="265" r="75"></circle>
    <g class="cd-node">
      <circle class="cd-agent" cx="1050" cy="265" r="75"></circle>
      <text class="cd-label" x="1050" y="260" text-anchor="middle">Agent</text>
      <text class="cd-label" x="1050" y="284" text-anchor="middle">Runtime</text>
    </g>
    <text class="cd-sub" x="1050" y="374" text-anchor="middle"
      >standing agent</text
    >

    <!-- Host (behind the seams) -->
    <rect class="cd-hostbox" x="880" y="430" width="280" height="100" rx="12"
    ></rect>
    <text class="cd-label" x="1020" y="474" text-anchor="middle">HOST</text>
    <text class="cd-sub" x="1020" y="500" text-anchor="middle"
      >policy · telemetry · memory</text
    >
    <line class="cd-seam" x1="860" y1="300" x2="1020" y2="430"></line>
    <text class="cd-sub cd-seamlabel" x="946" y="352" text-anchor="middle"
      >seams</text
    >

    <!-- Forward route: client -> gateway -> router -> agent -->
    <line
      class="cd-route"
      x1="210"
      y1="260"
      x2="336"
      y2="260"
      marker-end="url(#cd-arrow)"></line>
    <line class="cd-flow cd-flow-task" x1="210" y1="260" x2="336" y2="260"
    ></line>
    <text class="cd-edgelabel" x="273" y="242" text-anchor="middle"
      >POST /task</text
    >

    <line
      class="cd-route"
      x1="520"
      y1="265"
      x2="596"
      y2="265"
      marker-end="url(#cd-arrow)"></line>
    <line class="cd-flow cd-flow-task" x1="520" y1="265" x2="596" y2="265"
    ></line>
    <text class="cd-edgelabel" x="558" y="247" text-anchor="middle">route</text>

    <line
      class="cd-route"
      x1="760"
      y1="265"
      x2="971"
      y2="265"
      marker-end="url(#cd-arrow)"></line>
    <line class="cd-flow cd-flow-task" x1="760" y1="265" x2="971" y2="265"
    ></line>
    <text class="cd-edgelabel" x="865" y="247" text-anchor="middle"
      >A2A task</text
    >

    <!-- Registration heartbeat: gateway -> registry -->
    <path
      class="cd-hb"
      d="M 430 320 L 430 450 L 596 450"
      marker-end="url(#cd-arrow)"></path>
    <text class="cd-hblabel" x="513" y="436" text-anchor="middle"
      >register · heartbeat</text
    >

    <!-- Return route: agent -> client (NDJSON event stream) -->
    <path
      class="cd-route"
      d="M 1050 340 L 1050 640 L 125 640 L 125 314"
      marker-end="url(#cd-arrow)"></path>
    <path class="cd-flow cd-flow-event" d="M 1050 340 L 1050 640 L 125 640 L 125 314"
    ></path>
    <text class="cd-edgelabel cd-eventlabel" x="590" y="622" text-anchor="middle"
      >NDJSON event stream</text
    >

    <!-- Animated packets: task forward (teal), events back (sky), heartbeat.
         Each packet's keyframes encode its slot inside one full loop, so the
         legs chain into a continuous flow without animation-delay juggling. -->
    <circle class="cd-packet cd-pk1" cx="210" cy="260" r="7"></circle>
    <circle class="cd-packet cd-pk2" cx="520" cy="265" r="7"></circle>
    <circle class="cd-packet cd-pk3" cx="760" cy="265" r="7"></circle>
    <circle class="cd-packet cd-pk4" cx="1050" cy="340" r="7"></circle>
    <circle class="cd-packet cd-pk5" cx="1050" cy="640" r="7"></circle>
    <circle class="cd-packet cd-pk6" cx="125" cy="640" r="7"></circle>
    <circle class="cd-packet cd-pk7" cx="430" cy="320" r="5"></circle>
    <circle class="cd-packet cd-pk8" cx="430" cy="450" r="5"></circle>
  </svg>
</div>

<style>
  .concept-figure {
    max-width: 56rem;
    margin: 0 auto var(--mesh-space-5);
    overflow-x: auto;
    border: 1px solid var(--mesh-neutral-2);
    border-radius: var(--mesh-radius-lg);
    background: var(--mesh-brand-navy);
  }

  .cd-svg {
    display: block;
    width: 100%;
    min-width: 46rem;
    height: auto;
  }

  .cd-svg text {
    font-family: var(--mesh-font-mono);
  }

  /* ---- Nodes ---- */
  .cd-node rect {
    fill: var(--mesh-neutral-1);
    stroke: var(--mesh-neutral-3);
    stroke-width: 1.5;
  }
  .cd-node .cd-gw-outer {
    fill: var(--mesh-neutral-1);
    stroke: #326ce5;
    stroke-width: 2.5;
  }
  .cd-node .cd-gw-inner {
    fill: none;
    stroke: #326ce5;
    stroke-width: 1.25;
    stroke-opacity: 0.65;
  }
  .cd-agent {
    fill: var(--mesh-neutral-1);
    stroke: #2dd4bf;
    stroke-width: 2.5;
  }
  .cd-label {
    fill: var(--mesh-neutral-7);
    font-size: 21px;
    font-weight: 600;
  }
  .cd-sub {
    fill: var(--mesh-neutral-5);
    font-size: 13.5px;
  }

  /* ---- Boundaries ---- */
  .cd-meshbox {
    fill: none;
    stroke: var(--mesh-neutral-3);
    stroke-width: 1.5;
    stroke-dasharray: 7 7;
  }
  .cd-hostbox {
    fill: none;
    stroke: var(--mesh-neutral-4);
    stroke-width: 1.5;
    stroke-dasharray: 7 7;
  }
  .cd-boxlabel {
    fill: var(--mesh-neutral-5);
    font-size: 15px;
    letter-spacing: 0.1em;
  }
  .cd-crdlabel {
    fill: var(--mesh-neutral-4);
  }
  .cd-chip rect {
    fill: var(--mesh-neutral-1);
    stroke: var(--mesh-neutral-3);
    stroke-width: 1.25;
  }
  .cd-chip text {
    fill: var(--mesh-neutral-6);
    font-size: 16px;
  }
  .cd-stem {
    stroke: var(--mesh-neutral-4);
    stroke-width: 1.25;
    stroke-dasharray: 3 5;
  }
  .cd-seam {
    stroke: var(--mesh-neutral-4);
    stroke-width: 1.75;
    stroke-dasharray: 5 6;
  }
  .cd-seamlabel {
    fill: var(--mesh-neutral-4);
    font-size: 13px;
  }

  /* ---- Routes ---- */
  .cd-route {
    stroke: #5a6883;
    stroke-width: 2;
    fill: none;
  }
  .cd-hb {
    stroke: #2dd4bf;
    stroke-width: 1.75;
    fill: none;
    stroke-dasharray: 5 7;
    animation: cd-march-slow 2.4s linear infinite;
  }
  .cd-flow {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 0.1 16;
    animation: cd-march 1.1s linear infinite;
  }
  .cd-flow-task {
    stroke: #2dd4bf;
  }
  .cd-flow-event {
    stroke: #38bdf8;
  }
  .cd-edgelabel {
    fill: var(--mesh-neutral-6);
    font-size: 15px;
  }
  .cd-hblabel {
    fill: var(--mesh-neutral-6);
    font-size: 13px;
  }
  .cd-eventlabel {
    fill: #38bdf8;
  }

  /* ---- Agent halo pulse ---- */
  .cd-halo {
    fill: none;
    stroke: #2dd4bf;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: cd-pulse 3s ease-in-out infinite;
  }

  /* ---- Packets ---- */
  .cd-packet {
    opacity: 0;
  }
  .cd-pk1,
  .cd-pk2,
  .cd-pk3 {
    fill: #2dd4bf;
    animation: 3s linear infinite;
  }
  .cd-pk1 {
    animation-name: cd-pk1;
  }
  .cd-pk2 {
    animation-name: cd-pk2;
  }
  .cd-pk3 {
    animation-name: cd-pk3;
  }
  .cd-pk4,
  .cd-pk5,
  .cd-pk6 {
    fill: #38bdf8;
    animation: 4s linear infinite;
  }
  .cd-pk4 {
    animation-name: cd-pk4;
  }
  .cd-pk5 {
    animation-name: cd-pk5;
  }
  .cd-pk6 {
    animation-name: cd-pk6;
  }
  .cd-pk7,
  .cd-pk8 {
    fill: #2dd4bf;
    animation: 2s linear infinite;
  }
  .cd-pk7 {
    animation-name: cd-pk7;
  }
  .cd-pk8 {
    animation-name: cd-pk8;
  }

  @keyframes cd-march {
    to {
      stroke-dashoffset: -16.1;
    }
  }
  @keyframes cd-march-slow {
    to {
      stroke-dashoffset: -12;
    }
  }
  @keyframes cd-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70% {
      transform: scale(1.22);
      opacity: 0;
    }
    100% {
      transform: scale(1.22);
      opacity: 0;
    }
  }
  /* Task packets hop client -> gateway -> router -> agent inside one 3s loop:
     leg 1 runs 0-33%, leg 2 33-66%, leg 3 66-100%. */
  @keyframes cd-pk1 {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    28% {
      opacity: 1;
    }
    33.3% {
      transform: translate(126px, 0);
      opacity: 0;
    }
    100% {
      transform: translate(126px, 0);
      opacity: 0;
    }
  }
  @keyframes cd-pk2 {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    33.3% {
      transform: translate(0, 0);
      opacity: 0;
    }
    38% {
      opacity: 1;
    }
    61% {
      opacity: 1;
    }
    66.6% {
      transform: translate(76px, 0);
      opacity: 0;
    }
    100% {
      transform: translate(76px, 0);
      opacity: 0;
    }
  }
  @keyframes cd-pk3 {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    66.6% {
      transform: translate(0, 0);
      opacity: 0;
    }
    71% {
      opacity: 1;
    }
    94% {
      opacity: 1;
    }
    100% {
      transform: translate(211px, 0);
      opacity: 0;
    }
  }
  /* Event packets ride the return path agent -> client inside one 4s loop:
     down 25-45%, across 45-90%, up 90-97.5%. */
  @keyframes cd-pk4 {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    25% {
      transform: translate(0, 0);
      opacity: 0;
    }
    28% {
      opacity: 1;
    }
    42% {
      opacity: 1;
    }
    45% {
      transform: translate(0, 300px);
      opacity: 0;
    }
    100% {
      transform: translate(0, 300px);
      opacity: 0;
    }
  }
  @keyframes cd-pk5 {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    45% {
      transform: translate(0, 0);
      opacity: 0;
    }
    48% {
      opacity: 1;
    }
    87% {
      opacity: 1;
    }
    90% {
      transform: translate(-925px, 0);
      opacity: 0;
    }
    100% {
      transform: translate(-925px, 0);
      opacity: 0;
    }
  }
  @keyframes cd-pk6 {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    90% {
      transform: translate(0, 0);
      opacity: 0;
    }
    92% {
      opacity: 1;
    }
    96% {
      opacity: 1;
    }
    97.5% {
      transform: translate(0, -326px);
      opacity: 0;
    }
    100% {
      transform: translate(0, -326px);
      opacity: 0;
    }
  }
  /* Heartbeat packets inside one 2s loop: down 0-50%, across 50-100%. */
  @keyframes cd-pk7 {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    45% {
      opacity: 1;
    }
    50% {
      transform: translate(0, 130px);
      opacity: 0;
    }
    100% {
      transform: translate(0, 130px);
      opacity: 0;
    }
  }
  @keyframes cd-pk8 {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    50% {
      transform: translate(0, 0);
      opacity: 0;
    }
    55% {
      opacity: 1;
    }
    95% {
      opacity: 1;
    }
    100% {
      transform: translate(166px, 0);
      opacity: 0;
    }
  }

  /* ---- Light theme (keyed off the explicit data-theme, like the page) ---- */
  :global(html[data-theme='light']) .concept-figure {
    background: #ffffff;
    border-color: #e2e8f2;
  }
  :global(html[data-theme='light']) .cd-node rect,
  :global(html[data-theme='light']) .cd-chip rect {
    fill: #ffffff;
    stroke: #d7deeb;
  }
  :global(html[data-theme='light']) .cd-agent {
    fill: #f0f9ff;
  }
  :global(html[data-theme='light']) .cd-label {
    fill: #10131c;
  }
  :global(html[data-theme='light']) .cd-sub,
  :global(html[data-theme='light']) .cd-boxlabel,
  :global(html[data-theme='light']) .cd-edgelabel,
  :global(html[data-theme='light']) .cd-hblabel {
    fill: #5a6883;
  }
  :global(html[data-theme='light']) .cd-crdlabel,
  :global(html[data-theme='light']) .cd-seamlabel {
    fill: #8c99b3;
  }
  :global(html[data-theme='light']) .cd-meshbox,
  :global(html[data-theme='light']) .cd-hostbox {
    stroke: #d7deeb;
  }
  :global(html[data-theme='light']) .cd-chip text {
    fill: #38435c;
  }
  :global(html[data-theme='light']) .cd-stem,
  :global(html[data-theme='light']) .cd-seam {
    stroke: #8c99b3;
  }
  :global(html[data-theme='light']) .cd-route {
    stroke: #8c99b3;
  }
  :global(html[data-theme='light']) .cd-eventlabel {
    fill: #0e7490;
  }

  /* ---- Reduced motion: static diagram, no packets ---- */
  @media (prefers-reduced-motion: reduce) {
    .cd-packet,
    .cd-halo {
      display: none;
    }
    .cd-flow,
    .cd-hb {
      animation: none;
    }
  }
</style>
