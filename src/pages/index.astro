          >Staging at
          <a href="https://k8sagentmesh.github.io/k8sAgentsMesh-website/"
            >k8sagentmesh.github.io</a
          ></span
        >
      </div>
    </footer>
    <script is:inline>
      // Theme toggle: flips data-theme and persists the choice under the same
      // key the Starlight docs pages use, so the preference follows the visitor.
      (function () {
        var btn = document.querySelector('.theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var next =
            document.documentElement.getAttribute('data-theme') === 'light'
              ? 'dark'
              : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('starlight-theme', next);
          } catch (e) {}
        });
      })();
    </script>
  </body>
