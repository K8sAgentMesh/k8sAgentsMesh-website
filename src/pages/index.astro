---
// K8sAgentMesh landing page (k8sagentmesh.github.io/k8sAgentsMesh-website).
// Standalone Astro page at `/` outside Starlight, which owns `/docs/**`,
// `/concepts/**` and `/community/**`.
// Content-complete build (ISI-6047): hero, feature grid, how-it-works strip
// (Gateway → Route → Memory), hosts section, GitHub CTA.
// ISI-6463 + ISI-6509: the hero shows the brand mark and an animated
// concept diagram (src/components/ConceptDiagram.astro — CSS-only motion,
// reduced-motion safe); the Blog nav link is gone with the blog itself.
// Dark-mode-first; tokens come from brand/tokens/tokens.css.
import logoDark from '../../brand/logos/k8sagentmesh-lockup-horizontal.svg';
import logoLight from '../../brand/logos/k8sagentmesh-lockup-mono-dark.svg';
import logoMarkDark from '../../brand/logos/k8sagentmesh-mark.svg';
import logoMarkLight from '../../brand/logos/k8sagentmesh-mark-mono-dark.svg';
import ConceptDiagram from '../components/ConceptDiagram.astro';

const BASE = import.meta.env.BASE_URL;
const GITHUB_URL = 'https://github.com/K8sAgentMesh/K8sAgentMesh';
// Absolute URLs for SEO/social meta (site + base come from astro.config).
const SITE = Astro.site ?? new URL('https://k8sagentmesh.github.io');
const PAGE_TITLE =
  'K8sAgentMesh — the mesh layer for agent teams on Kubernetes';
const PAGE_DESC =
  'K8sAgentMesh is the runtime-agnostic seam for standing AI agents on Kubernetes: protocol-first communication, discovery, and memory for self-orchestrating agent teams.';
const CANONICAL = new URL(BASE, SITE).href;
const OG_IMAGE = new URL(`${BASE}banner.png`, SITE).href;
const FEATURES = [
  {
    num: '01',
    title: 'Runtime-agnostic seam',
    body: 'Everything a runtime must provide is the 7-op RuntimeAdapter contract — Spawn, Register, Route, Hibernate, Wake, Stop, Recreate. Two adapters ship as references; a third means zero control-plane change.',
    href: `${BASE}concepts/architecture/`,
  },
  {
    num: '02',
    title: 'Per-pod gateways',
    body: 'Each pod runs a Gateway — the process manager that owns the agent lifecycle inside the pod, speaking the contract downward and A2A wire traffic upward.',
    href: `${BASE}concepts/lifecycle/`,
  },
  {
    num: '03',
    title: 'A2A wire types',
    body: 'Task, Event, Status, AgentCard, ModelRoute — the module owns the wire shapes; hosts stamp their own schema brand and pin their accepted revisions.',
    href: `${BASE}concepts/architecture/`,
  },
  {
    num: '04',
    title: 'Lifecycle events, by contract',
    body: 'Route, spawn and wake events ride a transport-agnostic contract: the Gateway is the sole producer, your LifecycleObserver the sole consumer. No telemetry SDK in the mesh — ever.',
    href: `${BASE}concepts/telemetry/`,
  },
  {
    num: '05',
    title: 'Scheduling as policy',
    body: 'The mesh runs a generic target-N scheduler loop; who deserves a slot is your SchedulingPolicy. k8squad\u2019s RolePool is policy #1 — projecting into MeshPool semantics, never replaced.',
    href: `${BASE}concepts/scheduling/`,
  },
  {
    num: '06',
    title: 'Temporal memory contract',
    body: 'Team context — decisions, artifacts, conversation state — is durable and addressable across ephemeral agent lifecycles. A recreated agent resumes with its history intact.',
    href: `${BASE}concepts/memory/`,
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={PAGE_DESC} />
    <meta name="color-scheme" content="dark light" />
    <title>{PAGE_TITLE}</title>
    <link rel="canonical" href={CANONICAL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="K8sAgentMesh" />
    <meta property="og:title" content={PAGE_TITLE} />
    <meta property="og:description" content={PAGE_DESC} />
    <meta property="og:url" content={CANONICAL} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="K8sAgentMesh — the mesh layer for agent teams on Kubernetes"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={PAGE_TITLE} />
    <meta name="twitter:description" content={PAGE_DESC} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <script is:inline>
      // Seed the theme before first paint, mirroring the Starlight docs pages:
      // stored choice wins, else the OS preference. Dark is the brand default.
      try {
        var t = localStorage.getItem('starlight-theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    <style>
      @import '../../brand/tokens/tokens.css';

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        font-family: var(--mesh-font-body);
        background: var(--mesh-neutral-0);
        color: var(--mesh-neutral-6);
      }

      body {
        margin: 0;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--mesh-brand-primary);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      .wrap {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 var(--mesh-space-5);
      }

      /* ---- Skip link (a11y) ---- */
      .skip-link {
        position: absolute;
        left: var(--mesh-space-4);
        top: -100vh;
        z-index: 100;
        background: var(--mesh-brand-primary);
        color: var(--mesh-neutral-0);
        padding: var(--mesh-space-2) var(--mesh-space-4);
        border-radius: var(--mesh-radius-md);
        font-weight: 600;
      }
      .skip-link:focus {
        top: var(--mesh-space-3);
        text-decoration: none;
      }

      /* ---- Keyboard focus (a11y) ---- */
      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--mesh-brand-primary-strong);
        outline-offset: 2px;
        border-radius: var(--mesh-radius-sm);
      }

      /* ---- Header ---- */
      header {
        border-bottom: 1px solid var(--mesh-neutral-2);
      }
      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--mesh-space-4);
        padding: var(--mesh-space-4) var(--mesh-space-5);
        max-width: 72rem;
        margin: 0 auto;
      }
      .brand {
        display: inline-flex;
        align-items: center;
      }
      .brand-logo {
        height: 1.75rem;
        width: auto;
        display: block;
      }
      /* Hero mark: the brand logo on the main page (ISI-6509). Theme-aware
       * pair like the header lockup; exactly one variant is rendered at a
       * time (the other is display:none), and both carry the same alt text
       * so assistive tech always sees exactly one named logo. Never
       * recolored or animated (brand guide §3). */
      .hero-logo {
        height: 6.5rem;
        width: auto;
        display: block;
        margin: 0 auto var(--mesh-space-5);
      }
      /* The lockup is theme-aware: full-color on the dark header, monochrome
       * dark on light surfaces (brand guide §1). One is always display:none,
       * so assistive tech sees exactly one logo. The hero mark follows the
       * same pair pattern. */
      html[data-theme='dark'] .brand .logo-light,
      html:not([data-theme='light']) .brand .logo-light,
      html[data-theme='dark'] .hero-logo.logo-light,
      html:not([data-theme='light']) .hero-logo.logo-light {
        display: none;
      }
      html[data-theme='light'] .brand .logo-dark,
      html[data-theme='light'] .hero-logo.logo-dark {
        display: none;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: var(--mesh-space-5);
        font-size: 0.95rem;
      }
      .nav-links a {
        color: var(--mesh-neutral-5);
      }
      .nav-links a:hover {
        color: var(--mesh-neutral-7);
        text-decoration: none;
      }

      /* ---- Theme toggle (mirrors the Starlight docs pages) ---- */
      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        background: none;
        border: 1px solid var(--mesh-neutral-3);
        border-radius: var(--mesh-radius-md);
        color: var(--mesh-neutral-5);
        cursor: pointer;
      }
      .theme-toggle:hover {
        color: var(--mesh-neutral-7);
        border-color: var(--mesh-brand-primary);
      }
      .theme-toggle svg {
        width: 1.1rem;
        height: 1.1rem;
      }
      /* dark mode shows the sun (switch to light); light mode shows the moon */
      html[data-theme='dark'] .theme-toggle .icon-moon,
      html:not([data-theme='light']) .theme-toggle .icon-moon {
        display: none;
      }
      html[data-theme='light'] .theme-toggle .icon-sun {
        display: none;
      }

      /* ---- Hero ---- */
      .hero {
        padding: var(--mesh-space-9) 0 var(--mesh-space-8);
        text-align: center;
      }
      .kicker {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--mesh-brand-accent-soft);
        border: 1px solid var(--mesh-neutral-3);
        border-radius: var(--mesh-radius-pill);
        padding: var(--mesh-space-1) var(--mesh-space-4);
        margin-bottom: var(--mesh-space-5);
      }
      h1 {
        font-size: clamp(2.1rem, 5vw, 3.4rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0 0 var(--mesh-space-4);
        color: var(--mesh-neutral-7);
        max-width: 21ch;
        margin-left: auto;
        margin-right: auto;
      }
      h1 .accent {
        color: var(--mesh-brand-primary);
      }
      .lede {
        font-size: 1.15rem;
        max-width: 62ch;
        margin: 0 auto var(--mesh-space-6);
        color: var(--mesh-neutral-5);
      }
      .cta-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--mesh-space-4);
      }
      .start-cta {
        text-align: center;
        margin: var(--mesh-space-6) 0 0;
      }
      .btn {
        display: inline-block;
        padding: var(--mesh-space-3) var(--mesh-space-6);
        border-radius: var(--mesh-radius-md);
        font-weight: 600;
        font-size: 1rem;
      }
      .btn-primary {
        background: var(--mesh-brand-primary);
        color: var(--mesh-neutral-0);
      }
      .btn-primary:hover {
        background: var(--mesh-brand-primary-soft);
        text-decoration: none;
      }
      .btn-ghost {
        border: 1px solid var(--mesh-neutral-3);
        color: var(--mesh-neutral-7);
      }
      .btn-ghost:hover {
        border-color: var(--mesh-brand-primary);
        text-decoration: none;
      }

      /* ---- Concept band (diagram + animation, ISI-6509) ---- */
      .concept {
        padding: var(--mesh-space-8) 0;
      }
      .concept-intro {
        text-align: center;
        font-size: 1.05rem;
        color: var(--mesh-neutral-5);
        max-width: 52ch;
        margin: calc(-1 * var(--mesh-space-4)) auto var(--mesh-space-5);
      }
      .concept-caption {
        text-align: center;
        font-size: 0.9rem;
        color: var(--mesh-neutral-5);
        max-width: 62ch;
        margin: 0 auto;
      }
      .concept-caption a {
        white-space: nowrap;
      }

      section h2 {
        text-align: center;
        font-size: 1.6rem;
        letter-spacing: -0.01em;
        color: var(--mesh-neutral-7);
        margin: 0 0 var(--mesh-space-6);
      }

      /* ---- Features ---- */
      .features {
        padding: var(--mesh-space-8) 0;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--mesh-space-5);
        align-items: stretch;
      }
      .card {
        background: var(--mesh-neutral-1);
        border: 1px solid var(--mesh-neutral-2);
        border-radius: var(--mesh-radius-lg);
        padding: var(--mesh-space-5);
        color: inherit;
        display: block;
      }
      .card:hover {
        border-color: var(--mesh-brand-primary);
        text-decoration: none;
      }
      .card .num {
        font-family: var(--mesh-font-mono);
        font-size: 0.8rem;
        color: var(--mesh-brand-accent-soft);
        display: block;
        margin-bottom: var(--mesh-space-2);
      }
      .card h3 {
        margin: 0 0 var(--mesh-space-2);
        font-size: 1.15rem;
        color: var(--mesh-neutral-7);
      }
      .card p {
        margin: 0;
        font-size: 0.95rem;
        color: var(--mesh-neutral-5);
      }

      /* ---- How it works ---- */
      .how {
        padding: var(--mesh-space-8) 0;
      }
      .strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--mesh-space-5);
        align-items: stretch;
      }
      .step {
        background: var(--mesh-neutral-1);
        border: 1px solid var(--mesh-neutral-2);
        border-radius: var(--mesh-radius-lg);
        padding: var(--mesh-space-5);
      }
      .step .num {
        font-family: var(--mesh-font-mono);
        font-size: 0.8rem;
        color: var(--mesh-brand-accent-soft);
        display: block;
        margin-bottom: var(--mesh-space-2);
      }
      .step h3 {
        margin: 0 0 var(--mesh-space-2);
        font-size: 1.15rem;
        color: var(--mesh-neutral-7);
      }
      .step p {
        margin: 0;
        font-size: 0.95rem;
        color: var(--mesh-neutral-5);
      }

      /* ---- Hosts ---- */
      .hosts {
        padding: var(--mesh-space-8) 0;
      }
      .hosts .pane {
        background: var(--mesh-brand-navy);
        border: 1px solid var(--mesh-neutral-2);
        border-radius: var(--mesh-radius-lg);
        padding: var(--mesh-space-6);
        max-width: 62ch;
        margin: 0 auto;
        text-align: left;
      }
      .hosts .pane h3 {
        margin: 0 0 var(--mesh-space-2);
        font-size: 1.2rem;
        color: var(--mesh-neutral-7);
      }
      .hosts .pane p {
        margin: 0 0 var(--mesh-space-3);
        color: var(--mesh-neutral-5);
      }
      .hosts .pane p:last-child {
        margin: 0;
      }

      /* ---- Footer ---- */
      footer {
        border-top: 1px solid var(--mesh-neutral-2);
        margin-top: var(--mesh-space-8);
        padding: var(--mesh-space-6) 0;
        font-size: 0.9rem;
        color: var(--mesh-neutral-5);
      }
      footer .wrap {
        display: flex;
        flex-wrap: wrap;
        gap: var(--mesh-space-4);
        justify-content: space-between;
      }

      /* Light theme override for the standalone page. Keyed off the explicit
       * data-theme (set from the stored choice or OS preference above), NOT a
       * prefers-color-scheme media query — a user who picks light on a dark-OS
       * machine must still get the light page. */
      html[data-theme='light'] {
        background: #f6f8fc;
        color: #38435c;
      }
      html[data-theme='light'] h1,
      html[data-theme='light'] section h2,
      html[data-theme='light'] .card h3,
      html[data-theme='light'] .step h3,
      html[data-theme='light'] .hosts .pane h3,
      html[data-theme='light'] .btn-ghost {
        color: #10131c;
      }
      html[data-theme='light'] .card,
      html[data-theme='light'] .step {
        background: #ffffff;
        border-color: #e2e8f2;
      }
      html[data-theme='light'] .card:hover {
        border-color: #0f766e;
      }
      html[data-theme='light'] .hosts .pane {
        background: #ffffff;
        border-color: #e2e8f2;
      }
      html[data-theme='light'] .nav-links a,
      html[data-theme='light'] .lede,
      html[data-theme='light'] .concept-intro,
      html[data-theme='light'] .concept-caption,
      html[data-theme='light'] .card p,
      html[data-theme='light'] .step p,
      html[data-theme='light'] .hosts .pane p {
        color: #5a6883;
      }
      /* Links: raw compass teal fails AA on the light canvas (1.75:1); use
       * the text-safe teal-700, matching the docs' light accent. */
      html[data-theme='light'] a {
        color: #0f766e;
      }
      html[data-theme='light'] .btn-primary {
        background: #0f766e;
        color: #ffffff;
      }
      html[data-theme='light'] .kicker {
        color: #0e7490;
      }
      html[data-theme='light'] .theme-toggle {
        color: #5a6883;
        border-color: #e2e8f2;
      }
      html[data-theme='light'] .theme-toggle:hover {
        color: #10131c;
        border-color: #0f766e;
      }
      html[data-theme='light'] a:focus-visible,
      html[data-theme='light'] button:focus-visible {
        outline-color: #0f766e;
      }

      /* Responsive: stack grids under ~48rem. */
      @media (max-width: 48rem) {
        .grid,
        .strip {
          grid-template-columns: 1fr;
        }
        .nav-links {
          gap: var(--mesh-space-4);
          font-size: 0.9rem;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header>
      <nav class="nav">
        <a class="brand" href={`${BASE}`} aria-label="K8sAgentMesh — home">
          <img
            class="brand-logo logo-dark"
            src={logoDark.src}
            alt=""
            width="618"
            height="128"
          />
          <img
            class="brand-logo logo-light"
            src={logoLight.src}
            alt=""
            width="618"
            height="128"
          />
        </a>
        <div class="nav-links">
          <a href={`${BASE}docs/`}>Docs</a>
          <a href={`${BASE}concepts/architecture/`}>Concepts</a>
          <a href={`${BASE}community/`}>Community</a>
          <a href={GITHUB_URL}>GitHub</a>
          <button
            class="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            title="Toggle color theme"
          >
            <svg
              class="icon-sun"
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
            </svg>
            <svg
              class="icon-moon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero wrap">
        <img
          class="hero-logo logo-dark"
          src={logoMarkDark.src}
          alt="K8sAgentMesh logo"
          width="256"
          height="256"
        />
        <img
          class="hero-logo logo-light"
          src={logoMarkLight.src}
          alt="K8sAgentMesh logo"
          width="256"
          height="256"
        />
        <span class="kicker">Protocol-first agent mesh</span>
        <h1>
          The <span class="accent">mesh layer</span> for agent teams on
          Kubernetes
        </h1>
        <p class="lede">
          K8sAgentMesh is the runtime-agnostic seam for standing AI agents:
          communication, discovery, and memory for self-orchestrating agent
          teams — a mesh any platform can host.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={GITHUB_URL}>View on GitHub</a>
          <a class="btn btn-ghost" href={`${BASE}docs/`}>Read the docs</a>
        </div>
      </section>

      <section class="concept wrap" id="architecture">
        <h2>A seam, not a silo</h2>
        <p class="concept-intro">
          Pod gateways, a router, and a registry — wrapped around one small
          contract.
        </p>
        <ConceptDiagram />
        <p class="concept-caption">
          The mesh owns mechanism — gateways, routing, lifecycle, registration
          seams. Everything else is a host decision.
          <a href={`${BASE}concepts/architecture/`}>
            Read the architecture overview →
          </a>
        </p>
      </section>

      <section class="features wrap">
        <h2>What the mesh gives you</h2>
        <div class="grid">
          {
            FEATURES.map((f) => (
              <a class="card" href={f.href}>
                <span class="num">{f.num}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="how wrap">
        <h2>How it works</h2>
        <div class="strip">
          <div class="step">
            <span class="num">01</span>
            <h3>Gateway</h3>
            <p>
              Every pod runs a per-pod gateway — the agent process manager that
              owns spawn, registration, and lifecycle.
            </p>
          </div>
          <div class="step">
            <span class="num">02</span>
            <h3>Route</h3>
            <p>
              The router moves A2A wire traffic between agents across the mesh:
              task, event, status, and model routes.
            </p>
          </div>
          <div class="step">
            <span class="num">03</span>
            <h3>Memory</h3>
            <p>
              A temporal memory contract keeps team context durable across
              ephemeral agent lifecycles.
            </p>
          </div>
        </div>
      </section>

      <section class="hosts wrap">
        <h2>Hosts, not owners</h2>
        <div class="pane">
          <h3>Keep your control plane</h3>
          <p>
            The module owns the mechanism — gateways, routing, lifecycle,
            registration seams, the event contract — and nothing else. Scheduling
            decisions, identity, telemetry backends and memory stores stay
            host-side, plugged in behind the seams.
          </p>
          <p>
            k8squad is host #1: it pins the module with its role-based
            scheduling running as SchedulingPolicy #1, and its CRDs project into
            the mesh contracts rather than being replaced by them.
          </p>
          <p>
            <a href={`${BASE}concepts/hosts/`}>What the module owns vs. what stays host-side →</a>
          </p>
        </div>
      </section>

      <section class="how wrap">
        <h2>Get started in three steps</h2>
        <div class="strip">
          <div class="step">
            <span class="num">01</span>
            <h3>Create a cluster</h3>
            <p>
              Spin up a fresh kind cluster — the quickstart's zero-host-project
              path needs nothing but a container runtime.
            </p>
          </div>
          <div class="step">
            <span class="num">02</span>
            <h3>Install the chart</h3>
            <p>
              One helm install of the vanilla chart — no host project, no
              dependencies, fully independent.
            </p>
          </div>
          <div class="step">
            <span class="num">03</span>
            <h3>Run your first task</h3>
            <p>
              POST a task to the gateway and watch the A2A NDJSON event stream
              settle to a terminal state.
            </p>
          </div>
        </div>
        <p class="start-cta">
          <a class="btn btn-primary" href={`${BASE}docs/quickstart/`}>
            Open the quickstart
          </a>
        </p>
      </section>
    </main>

